rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }
    
    // Helper function to check if user is in admins collection
    function isAdminInCollection() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Reports collection - for anonymous user reports
    match /reports/{caseId} {
      // Allow anonymous users to create reports
      allow create: if true;
      
      // Allow anyone to read (for status checking with case ID)
      allow read: if true;
      
      // Allow authenticated admins to update/delete reports
      allow update: if isAdmin() || isAdminInCollection();
      allow delete: if isAdmin() || isAdminInCollection();
    }
    
    // Admin notifications collection - for admin dashboard notifications
    match /admin_notifications/{notificationId} {
      // Allow creation from anywhere (for automatic notification generation)
      allow create: if true;
      
      // Only authenticated admins can read, update, delete
      allow read: if isAdmin() || isAdminInCollection();
      allow update, delete: if isAdmin() || isAdminInCollection();
    }
    
    // Admin users/admins collection - for admin management
    match /admins/{adminId} {
      // Only authenticated admins can read admin data
      allow read: if isAdmin() || isAdminInCollection();
      
      // Admin creation should be done via Console or server-side
      allow create, update, delete: if false;
    }
    
    // Admin messages collection - for internal admin communication
    match /admin_messages/{messageId} {
      // Only authenticated admins can access messages
      allow read, write: if isAdmin() || isAdminInCollection();
    }
    
    // Admin activities collection - for tracking admin actions and recent activity
    match /admin_activities/{activityId} {
      // Allow creation from anywhere (for automatic activity logging)
      allow create: if true;
      
      // Only authenticated admins can read activities
      allow read: if isAdmin() || isAdminInCollection();
      
      // Only admins can update/delete activities
      allow update, delete: if isAdmin() || isAdminInCollection();
    }
    
    // App usage analytics collection - for anonymous, aggregated usage metrics
    match /app_usage_analytics/{document=**} {
      // Allow authenticated admins to read analytics data
      allow read: if isAdmin() || isAdminInCollection();
      
      // Allow write access for analytics collection
      // In production, set this to false and use Cloud Functions for writes
      allow write: if true; // TEMPORARY - change to false in production
    }
    
    // Deny all other access by default for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
