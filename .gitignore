# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
node_modules

# Local machine-specific config, never portable across devs/CI
android/local.properties

# Firebase client configs — contain project/app IDs and API keys. Firebase's
# actual security boundary is Firestore/Storage rules, not secrecy of these
# files, but they're still excluded going forward so updates aren't pushed.
# Each dev/CI environment needs to provide these separately (flutterfire
# configure, or copy from the Firebase console) since they're no longer
# tracked.
android/app/google-services.json
ios/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Firebase CLI's local hosting/deploy cache — not meant to be shared
.firebase/

# Claude Code's own session/tool state — never belongs in the repo
.claude/
